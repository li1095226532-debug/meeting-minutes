# ===== 会议纪要助手 - 环境配置 =====
# 复制此文件为 .env 并填入实际值

# --- Claude API Key（AI 会议总结，不设置则只做转写）---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- 语音转文字后端选择 ---
# auto: 自动检测（faster-whisper > openai-whisper > OpenAI API）
# faster-whisper: 推荐，需 Python 3.9+，支持 GPU 加速
# openai-whisper: 备选，支持 Python 3.8+，CPU 运行
# openai-api: 使用 OpenAI 云端 Whisper API
WHISPER_BACKEND=auto

# --- 模型大小（仅本地后端有效）---
# tiny / base / small / medium / large
# 越大越准但越慢，推荐 medium
WHISPER_MODEL=medium

# --- faster-whisper 专用 ---
# 运行设备: auto / cpu / cuda
WHISPER_DEVICE=auto
# 计算精度: auto / float16 / int8
WHISPER_COMPUTE_TYPE=auto

# --- OpenAI API 专用（使用 openai-api 后端时必填）---
# OPENAI_API_KEY=sk-xxxxx
